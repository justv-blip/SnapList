# ─────────────────────────────────────────────────────────────
# SnapList — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Server-side only, never expose to client

# ── Anthropic (Claude Vision) ─────────────────────────────────
# Required for card scanning. Without this, every scan returns "vision disabled".
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── Stripe (Subscriptions) ────────────────────────────────────
# Get keys at: https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_...) for development, live keys (sk_live_...) for production.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...   # From: Stripe Dashboard → Webhooks → your endpoint → Signing secret

# Stripe Price IDs — one per tier per billing interval.
# Run `node scripts/setup-stripe.js` to create products/prices and auto-populate these.
STRIPE_PRICE_LISTER_MONTHLY=price_...
STRIPE_PRICE_LISTER_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_ANNUAL=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_...

# ── JustTCG (Pricing layer for 13+ games) ────────────────────
# Required for market prices. Get key at: https://justtcg.com
JUSTTCG_API_KEY=your-justtcg-key

# ── PokémonTCG (Optional — higher rate limits) ───────────────
# Works without a key but is heavily rate-limited. Get one at: https://dev.pokemontcg.io/
POKEMON_TCG_API_KEY=your-pokemon-tcg-key

# ── eBay (Direct listing integration) ────────────────────────
# Create an app at: https://developer.ebay.com/
# Set OAuth redirect URI to: https://yourdomain.com/api/ebay/callback
EBAY_CLIENT_ID=your-ebay-client-id
EBAY_CLIENT_SECRET=your-ebay-client-secret
EBAY_REDIRECT_URI=https://yourdomain.com/api/ebay/callback

# Set to "true" to use eBay Sandbox environment (for development/testing).
# Leave unset or "false" for production.
NEXT_PUBLIC_EBAY_SANDBOX=false

# eBay webhook verification — found in: eBay Developer → Notifications
EBAY_WEBHOOK_VERIFICATION_TOKEN=your-verification-token
EBAY_WEBHOOK_ENDPOINT=https://yourdomain.com/api/ebay/webhooks

# ── App URL (used for OAuth callbacks, email links) ──────────
NEXT_PUBLIC_SITE_URL=https://snaplist.gg
