# Copy this file to `.env.local` and fill in your key(s).
# `.env.local` is gitignored and only read by the backend at runtime.

# Required for vision-based card scanning. Get one at https://console.anthropic.com
# If left blank, the app runs in manual-entry mode (no vision scans).
ANTHROPIC_API_KEY=

# Optional. Increases Pokemon TCG API rate limits. Get one at https://dev.pokemontcg.io
POKEMON_TCG_API_KEY=

# Recommended. Enables unified pricing for 13+ TCGs (One Piece, Gundam, Digimon,
# Lorcana, Dragon Ball, Flesh and Blood, Union Arena, and more).
# Sign up for a free API key at https://justtcg.com
# Without this key, the app still works — but pricing for non-Pokemon/MTG/YGO games
# will be unavailable and the user will need to enter prices manually.
JUSTTCG_API_KEY=
