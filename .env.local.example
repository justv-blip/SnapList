# ─────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in every value.
# `.env.local` is gitignored and is never committed to source control.
# ─────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────
# Your project URL and anon key are safe to expose to the client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — NEVER expose this to the client.
# Used for admin operations (Stripe webhooks, etc.) that bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic ─────────────────────────────────────────────────────
# Required for vision-based card scanning. Get one at https://console.anthropic.com
# If left blank, the app runs in manual-entry mode (no vision scans).
ANTHROPIC_API_KEY=

# ── Stripe ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
# Local webhook secret from `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs for each tier × interval combination.
# Create these in your Stripe dashboard under Products.
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_ANNUAL=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_...

# ── eBay ──────────────────────────────────────────────────────────
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=https://your-domain.com/api/ebay/callback
# Set to "production" to use live eBay API; anything else uses sandbox.
EBAY_ENVIRONMENT=sandbox
# Verification token for eBay webhook challenge requests (set in eBay developer portal).
EBAY_VERIFICATION_TOKEN=

# ── Card data APIs ────────────────────────────────────────────────
# Optional — increases Pokémon TCG API rate limits. https://dev.pokemontcg.io
POKEMON_TCG_API_KEY=

# Recommended — unified pricing for 13+ TCGs (One Piece, Gundam, Lorcana, etc.)
# Without this key, pricing for non-Pokémon/MTG/YGO games won't be available.
# Sign up at https://justtcg.com
JUSTTCG_API_KEY=

# ── Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=re_...
# Address that receives contact-form submissions.
CONTACT_NOTIFY_EMAIL=you@yourdomain.com

# ── App URL ───────────────────────────────────────────────────────
# Used for OAuth redirects and absolute URL generation.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Cron ─────────────────────────────────────────────────────────
# Random secret that Vercel passes to /api/cron/* routes as Authorization: Bearer.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Sentry ────────────────────────────────────────────────────────
# Optional — if not set, Sentry does nothing at runtime.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
